namespace cdm.ingest.fpml.confirmation.product.fxtargetknockoutforward: <"FpML FxTargetKnockoutForward (FX Target Redemption Forward) product mapping functions.">
version "${project.version}"

import cdm.base.datetime.*
import cdm.base.math.*
import cdm.base.staticdata.party.*
import cdm.ingest.fpml.confirmation.common.*
import cdm.ingest.fpml.confirmation.datetime.*
import cdm.ingest.fpml.confirmation.party.*
import cdm.ingest.fpml.confirmation.pricequantity.*
import cdm.observable.asset.*
import cdm.observable.event.*
import cdm.product.common.schedule.*
import cdm.product.common.settlement.*
import cdm.product.template.*

import fpml.consolidated.* as fpml
import fpml.consolidated.fpmlenum.* as fpml
import fpml.consolidated.fx.targets.* as fpml

func MapFxTargetKnockoutForwardCounterpartyList:
    inputs:
        fpmlFxTargetKnockoutForward fpml.FxTargetKnockoutForward (0..1)
    output:
        counterpartyList Counterparty (0..2)

    alias fpmlExchangedCurrency:
        GetFxTargetLinearPayoffRegionList(fpmlFxTargetKnockoutForward) first -> exchangedCurrency1

    add counterpartyList:
        MapPayerReceiverModelToCounterpartyList(
                fpmlExchangedCurrency -> payerPartyReference,
                fpmlExchangedCurrency -> receiverPartyReference
            )

func MapFxTargetKnockoutForwardNonTransferableProduct:
    inputs:
        fpmlFxTargetKnockoutForward fpml.FxTargetKnockoutForward (0..1)
        cdmCounterpartyList Counterparty (0..2)
    output:
        nonTransferableProduct NonTransferableProduct (0..1)

    set nonTransferableProduct:
        NonTransferableProduct {
            identifier: MapProductIdentifierList(fpmlFxTargetKnockoutForward -> productId),
            taxonomy: MapProductTaxonomyList(
                        fpmlFxTargetKnockoutForward -> primaryAssetClass,
                        fpmlFxTargetKnockoutForward -> secondaryAssetClass,
                        fpmlFxTargetKnockoutForward -> productType
                    ),
            economicTerms: MapFxTargetKnockoutForwardEconomicTerms(
                        fpmlFxTargetKnockoutForward,
                        cdmCounterpartyList
                    )
        }

func MapFxTargetKnockoutForwardEconomicTerms:
    inputs:
        fpmlFxTargetKnockoutForward fpml.FxTargetKnockoutForward (0..1)
        cdmCounterpartyList Counterparty (0..2)
    output:
        economicTerms EconomicTerms (0..1)

    set economicTerms:
        EconomicTerms {
            payout: MapFxTargetKnockoutForwardPayoutList(
                        fpmlFxTargetKnockoutForward,
                        cdmCounterpartyList
                    ),
            terminationProvision:
                TerminationProvision {
                    contingentTerminationProvision: MapFxTargetKnockoutForwardContingentTerminationProvision(
                                fpmlFxTargetKnockoutForward
                            ),
                    ...
                },
            ...
        }

func MapFxTargetKnockoutForwardPayoutList: <"Maps the linear payoff regions and the constant payoff regions with a payoff of a TARF to settlement payouts.">
    inputs:
        fpmlFxTargetKnockoutForward fpml.FxTargetKnockoutForward (0..1)
        cdmCounterpartyList Counterparty (0..2)
    output:
        payoutList Payout (0..*)

    add payoutList:
        GetFxTargetLinearPayoffRegionList(fpmlFxTargetKnockoutForward)
            extract
                MapFxTargetLinearPayoffRegionToSettlementPayout(
                        item,
                        fpmlFxTargetKnockoutForward,
                        cdmCounterpartyList
                    )

    add payoutList:
        GetFxTargetConstantPayoffRegionList(fpmlFxTargetKnockoutForward)
            filter payoff exists
            then extract
                MapFxTargetConstantPayoffRegionToSettlementPayout(
                        item,
                        fpmlFxTargetKnockoutForward,
                        cdmCounterpartyList
                    )

func GetFxTargetLinearPayoffRegionList: <"Returns all the linear payoff regions of a TARF.">
    inputs:
        fpmlFxTargetKnockoutForward fpml.FxTargetKnockoutForward (0..1)
    output:
        fpmlLinearPayoffRegionList fpml.FxTargetLinearPayoffRegion (0..*)

    add fpmlLinearPayoffRegionList: fpmlFxTargetKnockoutForward -> linearPayoffRegion

    add fpmlLinearPayoffRegionList:
        fpmlFxTargetKnockoutForward -> fxTargetKnockoutForwardChoice -> linearPayoffRegion

func GetFxTargetConstantPayoffRegionList: <"Returns all the constant payoff regions of a TARF.">
    inputs:
        fpmlFxTargetKnockoutForward fpml.FxTargetKnockoutForward (0..1)
    output:
        fpmlConstantPayoffRegionList fpml.FxTargetConstantPayoffRegion (0..*)

    add fpmlConstantPayoffRegionList: fpmlFxTargetKnockoutForward -> constantPayoffRegion

    add fpmlConstantPayoffRegionList:
        fpmlFxTargetKnockoutForward -> fxTargetKnockoutForwardChoice -> constantPayoffRegion

func GetFxTargetZeroPayoffRegionList: <"Returns the constant payoff regions of a TARF which have no payoff, i.e. the zero regions.">
    inputs:
        fpmlFxTargetKnockoutForward fpml.FxTargetKnockoutForward (0..1)
    output:
        fpmlZeroPayoffRegionList fpml.FxTargetConstantPayoffRegion (0..*)

    add fpmlZeroPayoffRegionList:
        GetFxTargetConstantPayoffRegionList(fpmlFxTargetKnockoutForward)
            filter payoff is absent

func MapFxTargetLinearPayoffRegionToSettlementPayout: <"Maps a linear payoff region of a TARF to a settlement payout, i.e. the forward which settles at each fixing in the region.">
    inputs:
        fpmlLinearPayoffRegion fpml.FxTargetLinearPayoffRegion (0..1)
        fpmlFxTargetKnockoutForward fpml.FxTargetKnockoutForward (0..1)
        cdmCounterpartyList Counterparty (0..2)
    output:
        payout Payout (0..1)

    alias fpmlNotionalCurrency: fpmlFxTargetKnockoutForward -> notionalAmount -> currency

    alias exchangedCurrency:
        if fpmlLinearPayoffRegion -> exchangedCurrency1 -> currency -> value = fpmlNotionalCurrency -> value
        then fpmlLinearPayoffRegion -> exchangedCurrency1
        else fpmlLinearPayoffRegion -> exchangedCurrency2

    alias fpmlSettlementSchedule: fpmlFxTargetKnockoutForward -> settlementSchedule

    alias fpmlZeroPayoffRegionList:
        GetFxTargetZeroPayoffRegionList(fpmlFxTargetKnockoutForward)

    alias applicabilityList:
        if fpmlLinearPayoffRegion -> lowerBound exists
                or fpmlLinearPayoffRegion -> upperBound exists
        then [
                FixingCondition {
                    lowerBound: MapFxTargetRegionLowerBoundToFixingBound(
                                fpmlLinearPayoffRegion -> lowerBound,
                                fpmlFxTargetKnockoutForward
                            ),
                    upperBound: MapFxTargetRegionUpperBoundToFixingBound(
                                fpmlLinearPayoffRegion -> upperBound,
                                fpmlFxTargetKnockoutForward
                            )
                }
            ]
        else if fpmlZeroPayoffRegionList count = 1
        then MapFxTargetZeroPayoffRegionToComplementList(
                    fpmlZeroPayoffRegionList only-element,
                    fpmlFxTargetKnockoutForward
                )

    set payout:
        if fpmlLinearPayoffRegion exists
        then Payout {
                SettlementPayout:
                    SettlementPayout {
                        payerReceiver: MapPayerReceiver(
                                    exchangedCurrency -> payerPartyReference,
                                    exchangedCurrency -> receiverPartyReference,
                                    cdmCounterpartyList
                                ),
                        priceQuantity:
                            ResolvablePriceQuantity {
                                quantitySchedule: CreateQuantityWithAddress(
                                            CreateQuantityKey(
                                                    fpmlNotionalCurrency -> value,
                                                    empty
                                                )
                                        ),
                                priceSchedule: CreatePriceWithAddress(
                                            CreatePriceKey(
                                                    fpmlLinearPayoffRegion -> strike -> id,
                                                    empty
                                                )
                                        ),
                                ...
                            },
                        settlementTerms:
                            SettlementTerms {
                                settlementType: if fpmlFxTargetKnockoutForward -> cashSettlement exists
                                        then SettlementTypeEnum -> Cash
                                    else SettlementTypeEnum -> Physical,
                                settlementDate: if fpmlSettlementSchedule -> adjustedDate exists
                                        then SettlementDate {
                                            adjustableDates:
                                                AdjustableDates {
                                                    adjustedDate: fpmlSettlementSchedule -> adjustedDate -> date,
                                                    dateAdjustments: MapBusinessDayAdjustments(
                                                                fpmlSettlementSchedule -> dateAdjustments
                                                            ),
                                                    ...
                                                },
                                            ...
                                        },
                                ...
                            },
                        schedule: MapFxTargetSettlementPeriodScheduleToCalculationSchedule(
                                    fpmlFxTargetKnockoutForward -> settlementPeriodSchedule
                                ),
                        applicability: applicabilityList,
                        leverage: MapFxTargetLeverageToConditionalLeverage(
                                    fpmlLinearPayoffRegion -> leverage,
                                    fpmlFxTargetKnockoutForward
                                ),
                        underlier:
                            Underlier {
                                Observable: MapCurrencyToObservableCashWithAddress(
                                            exchangedCurrency -> currency,
                                            empty
                                        ),
                                ...
                            },
                        ...
                    },
                ...
            }

func MapFxTargetConstantPayoffRegionToSettlementPayout: <"Maps a constant payoff region of a TARF which has a payoff to a settlement payout which applies at each fixing in the region: either a cash payment (e.g. a digital TARF), or a forward settled at the fixing adjusted by a fixing adjustment (e.g. the bonus of a bonus collar TARF).">
    inputs:
        fpmlConstantPayoffRegion fpml.FxTargetConstantPayoffRegion (0..1)
        fpmlFxTargetKnockoutForward fpml.FxTargetKnockoutForward (0..1)
        cdmCounterpartyList Counterparty (0..2)
    output:
        payout Payout (0..1)

    alias fpmlPayoff: fpmlConstantPayoffRegion -> payoff

    alias fpmlPayment: fpmlPayoff -> payment

    alias fpmlNotionalCurrency: fpmlFxTargetKnockoutForward -> notionalAmount -> currency

    alias fpmlPhysicalSettlement: fpmlConstantPayoffRegion -> physicalSettlement

    alias exchangedCurrency:
        if fpmlPhysicalSettlement -> exchangedCurrency1 -> currency -> value = fpmlNotionalCurrency -> value
        then fpmlPhysicalSettlement -> exchangedCurrency1
        else fpmlPhysicalSettlement -> exchangedCurrency2

    alias fpmlSettlementSchedule: fpmlFxTargetKnockoutForward -> settlementSchedule

    alias settlementDate:
        if fpmlSettlementSchedule -> adjustedDate exists
        then SettlementDate {
                adjustableDates:
                    AdjustableDates {
                        adjustedDate: fpmlSettlementSchedule -> adjustedDate -> date,
                        dateAdjustments: MapBusinessDayAdjustments(
                                    fpmlSettlementSchedule -> dateAdjustments
                                ),
                        ...
                    },
                ...
            }

    alias applicability:
        FixingCondition {
            lowerBound: MapFxTargetRegionLowerBoundToFixingBound(
                        fpmlConstantPayoffRegion -> lowerBound,
                        fpmlFxTargetKnockoutForward
                    ),
            upperBound: MapFxTargetRegionUpperBoundToFixingBound(
                        fpmlConstantPayoffRegion -> upperBound,
                        fpmlFxTargetKnockoutForward
                    )
        }

    alias schedule:
        MapFxTargetSettlementPeriodScheduleToCalculationSchedule(
                fpmlFxTargetKnockoutForward -> settlementPeriodSchedule
            )

    set payout:
        if fpmlPayment exists
        then Payout {
                SettlementPayout:
                    SettlementPayout {
                        payerReceiver: MapPayerReceiver(
                                    fpmlPayoff -> payerPartyReference,
                                    fpmlPayoff -> receiverPartyReference,
                                    cdmCounterpartyList
                                ),
                        priceQuantity:
                            ResolvablePriceQuantity {
                                quantitySchedule: CreateQuantityWithAddress(
                                            CreateQuantityKey(
                                                    "constantPayoff" + fpmlPayment -> currency -> value,
                                                    empty
                                                )
                                        ),
                                ...
                            },
                        settlementTerms:
                            SettlementTerms {
                                settlementType: SettlementTypeEnum -> Cash,
                                settlementDate: settlementDate,
                                ...
                            },
                        schedule: schedule,
                        applicability: applicability,
                        underlier:
                            Underlier {
                                Observable: MapCurrencyToObservableCashWithAddress(
                                            fpmlPayment -> currency,
                                            empty
                                        ),
                                ...
                            },
                        ...
                    },
                ...
            }
        else if fpmlPayoff -> fixingAdjustment exists
        then Payout {
                SettlementPayout:
                    SettlementPayout {
                        payerReceiver: MapPayerReceiver(
                                    exchangedCurrency -> payerPartyReference,
                                    exchangedCurrency -> receiverPartyReference,
                                    cdmCounterpartyList
                                ),
                        priceQuantity:
                            ResolvablePriceQuantity {
                                quantitySchedule: CreateQuantityWithAddress(
                                            CreateQuantityKey(
                                                    fpmlNotionalCurrency -> value,
                                                    empty
                                                )
                                        ),
                                priceSchedule: CreatePriceWithAddress(
                                            CreatePriceKey("fixingAdjustment", empty)
                                        ),
                                ...
                            },
                        settlementTerms:
                            SettlementTerms {
                                settlementType: if fpmlFxTargetKnockoutForward -> cashSettlement exists
                                        then SettlementTypeEnum -> Cash
                                    else SettlementTypeEnum -> Physical,
                                settlementDate: settlementDate,
                                ...
                            },
                        schedule: schedule,
                        applicability: applicability,
                        underlier:
                            Underlier {
                                Observable: MapCurrencyToObservableCashWithAddress(
                                            exchangedCurrency -> currency,
                                            empty
                                        ),
                                ...
                            },
                        ...
                    },
                ...
            }

func MapFxTargetSettlementPeriodScheduleToCalculationSchedule: <"Maps the expiry and settlement dates of the settlement periods of a TARF to a calculation schedule. Other per-period terms (notional, strike, leverage, barrier) are not mapped.">
    inputs:
        fpmlSettlementPeriodSchedule fpml.FxTargetSettlementPeriodSchedule (0..1)
    output:
        calculationSchedule CalculationSchedule (0..1)

    set calculationSchedule:
        if fpmlSettlementPeriodSchedule exists
        then CalculationSchedule {
                schedulePeriod: fpmlSettlementPeriodSchedule -> settlementPeriod
                        extract
                            SchedulePeriod {
                                calculationPeriod:
                                    DateRange {
                                        startDate: item -> expiryDate -> date,
                                        endDate: item -> expiryDate -> date
                                    },
                                paymentDate: item -> settlementDate -> date,
                                fixingPeriod:
                                    DateRange {
                                        startDate: item -> expiryDate -> date,
                                        endDate: item -> expiryDate -> date
                                    },
                                ...
        }}

func MapFxTargetZeroPayoffRegionToComplementList: <"Maps the complement of a zero payoff region of a TARF, i.e. the fixing regions in which the linear payoff applies. A zero region bounded on both sides results in two regions.">
    inputs:
        fpmlZeroPayoffRegion fpml.FxTargetConstantPayoffRegion (0..1)
        fpmlFxTargetKnockoutForward fpml.FxTargetKnockoutForward (0..1)
    output:
        fixingConditionList FixingCondition (0..*)

    alias fpmlLowerBound: fpmlZeroPayoffRegion -> lowerBound

    alias fpmlUpperBound: fpmlZeroPayoffRegion -> upperBound

    add fixingConditionList:
        if fpmlLowerBound exists
        then FixingCondition {
                upperBound:
                    FixingBound {
                        triggerType: if fpmlLowerBound -> condition = AtOrAbove
                                then TriggerTypeEnum -> Less
                            else TriggerTypeEnum -> EqualOrLess,
                        level: MapFxTargetLevelToPrice(
                                    fpmlLowerBound -> level,
                                    fpmlLowerBound -> strikeReference,
                                    fpmlLowerBound -> pivotReference,
                                    fpmlLowerBound -> barrierReference,
                                    fpmlLowerBound -> levelReference,
                                    fpmlFxTargetKnockoutForward
                                )
                    },
                ...
            }

    add fixingConditionList:
        if fpmlUpperBound exists
        then FixingCondition {
                lowerBound:
                    FixingBound {
                        triggerType: if fpmlUpperBound -> condition = AtOrBelow
                                then TriggerTypeEnum -> Greater
                            else TriggerTypeEnum -> EqualOrGreater,
                        level: MapFxTargetLevelToPrice(
                                    fpmlUpperBound -> level,
                                    fpmlUpperBound -> strikeReference,
                                    fpmlUpperBound -> pivotReference,
                                    fpmlUpperBound -> barrierReference,
                                    fpmlUpperBound -> levelReference,
                                    fpmlFxTargetKnockoutForward
                                )
                    },
                ...
            }

func MapFxTargetLeverageToConditionalLeverage: <"Maps the leverage of a TARF linear payoff region, expressed either as a ratio or as a notional amount.">
    inputs:
        fpmlLeverage fpml.FxTargetLeverage (0..1)
        fpmlFxTargetKnockoutForward fpml.FxTargetKnockoutForward (0..1)
    output:
        conditionalLeverage ConditionalLeverage (0..1)

    alias fixingBound:
        FixingBound {
            triggerType: MapFxConditionEnum(fpmlLeverage -> condition),
            level: MapFxTargetLevelToPrice(
                        fpmlLeverage -> level,
                        fpmlLeverage -> strikeReference,
                        fpmlLeverage -> pivotReference,
                        fpmlLeverage -> barrierReference,
                        fpmlLeverage -> levelReference,
                        fpmlFxTargetKnockoutForward
                    )
        }

    set conditionalLeverage:
        if fpmlLeverage -> ratio exists or fpmlLeverage -> notionalAmount exists
        then ConditionalLeverage {
                fixingCondition: if fpmlLeverage -> condition = AtOrAbove
                            or fpmlLeverage -> condition = Above
                        then FixingCondition {
                            lowerBound: fixingBound,
                            ...
                        }
                    else FixingCondition {
                        upperBound: fixingBound,
                        ...
                    },
                ratio: if fpmlLeverage -> ratio exists
                        then NonNegativeSchedule {
                            value: fpmlLeverage -> ratio -> initialValue,
                            datedValue: MapScheduleToDatedValueList(
                                        fpmlLeverage -> ratio -> step
                                    )
                        },
                quantity: MapCurrencyAmountToQuantity(
                            fpmlLeverage -> notionalAmount -> initialValue,
                            empty,
                            fpmlLeverage -> notionalAmount -> currency,
                            empty
                        )
            }

func MapFxTargetKnockoutForwardContingentTerminationProvision: <"Maps the target(s), the global knock-out barrier(s) and the knock-out rebate of a TARF.">
    inputs:
        fpmlFxTargetKnockoutForward fpml.FxTargetKnockoutForward (0..1)
    output:
        contingentTerminationProvision ContingentTerminationProvision (0..1)

    alias fpmlGlobalKnockoutBarrierList:
        fpmlFxTargetKnockoutForward -> barrier
            filter barrierType = Knockout and scope = Global

    alias fpmlOutstandingGain:
        fpmlGlobalKnockoutBarrierList -> rebate -> outstandingGain first

    set contingentTerminationProvision:
        ContingentTerminationProvision {
            observationTerms: MapFxTargetKnockoutForwardObservationTerms(
                        fpmlFxTargetKnockoutForward
                    ),
            target: fpmlFxTargetKnockoutForward -> target
                    extract MapFxTargetToTargetTerms(item, fpmlFxTargetKnockoutForward),
            knockOut: fpmlGlobalKnockoutBarrierList
                    extract
                        MapFxTargetBarrierToTriggerEvent(item, fpmlFxTargetKnockoutForward),
            outstandingGainRebate: if fpmlOutstandingGain exists
                    then OutstandingGainRebate {
                        settlementAdjustmentStyle: MapFxSettlementAdjustmentMethodEnum(
                                    fpmlOutstandingGain -> settlementAdjustmentStyle
                                )
        }}

func MapFxTargetKnockoutForwardObservationTerms: <"Maps the fixing source, fixing time and fixing (expiry) dates of a TARF.">
    inputs:
        fpmlFxTargetKnockoutForward fpml.FxTargetKnockoutForward (0..1)
    output:
        observationTerms ObservationTerms (0..1)

    alias fpmlExpirySchedule: fpmlFxTargetKnockoutForward -> expirySchedule

    alias fpmlFixingInformationSource:
        fpmlFxTargetKnockoutForward -> fixingInformationSource

    set observationTerms:
        ObservationTerms {
            observationTime: MapBusinessCenterTime(
                        fpmlFixingInformationSource -> fixingTime
                    ),
            informationSource: if fpmlFixingInformationSource exists
                    then FxSpotRateSource {
                        primarySource: MapInformationSource(fpmlFixingInformationSource),
                        ...
                    },
            observationDates:
                ObservationDates {
                    observationSchedule:
                        ObservationSchedule {
                            observationDate: fpmlExpirySchedule -> adjustedDate
                                    extract
                                        ObservationDate {
                                            adjustedDate: item -> date,
                                            ...
                                        },
                            ...
                        },
                    ...
                },
            ...
        }

func MapFxTargetToTargetTerms:
    inputs:
        fpmlFxTarget fpml.FxTarget (0..1)
        fpmlFxTargetKnockoutForward fpml.FxTargetKnockoutForward (0..1)
    output:
        targetTerms TargetTerms (0..1)

    alias fpmlKnockoutLevel: fpmlFxTarget -> knockoutLevel

    set targetTerms:
        TargetTerms {
            accumulationRegion: fpmlFxTarget -> accumulationRegion
                    extract
                        AccumulationRegion {
                            fixingCondition:
                                FixingCondition {
                                    lowerBound: MapFxTargetRegionLowerBoundToFixingBound(
                                                item -> lowerBound,
                                                fpmlFxTargetKnockoutForward
                                            ),
                                    upperBound: MapFxTargetRegionUpperBoundToFixingBound(
                                                item -> upperBound,
                                                fpmlFxTargetKnockoutForward
                                            )
                                },
                            multiplier: item -> multiplier
                        },
            targetLevel: if fpmlKnockoutLevel exists
                    then TargetLevel {
                        amount: if fpmlKnockoutLevel -> amount exists
                                then Money {
                                    value: fpmlKnockoutLevel -> amount -> amount,
                                    unit:
                                        UnitType {
                                            currency: MapCurrency(
                                                        fpmlKnockoutLevel -> amount -> currency
                                                    ),
                                            ...
                                        },
                                    ...
                                },
                        intrinsicValue: fpmlKnockoutLevel -> intrinsicValue,
                        targetStyle: MapFxTargetStyleEnum(fpmlKnockoutLevel -> targetStyle),
                        settlementAdjustmentStyle: MapFxSettlementAdjustmentMethodEnum(
                                    fpmlKnockoutLevel -> settlementAdjustmentStyle
                                )
                    },
            targetCount: if fpmlFxTarget -> knockoutCount exists
                    then TargetCount {
                        conditionalFixings: fpmlFxTarget -> knockoutCount -> conditionalFixings,
                        settlementAtKnockout: fpmlFxTarget -> knockoutCount -> settlementAtKnockout
        }}

func MapFxTargetRegionLowerBoundToFixingBound:
    inputs:
        fpmlLowerBound fpml.FxTargetRegionLowerBound (0..1)
        fpmlFxTargetKnockoutForward fpml.FxTargetKnockoutForward (0..1)
    output:
        fixingBound FixingBound (0..1)

    set fixingBound:
        if fpmlLowerBound exists
        then FixingBound {
                triggerType: if fpmlLowerBound -> condition = AtOrAbove
                        then TriggerTypeEnum -> EqualOrGreater
                    else if fpmlLowerBound -> condition = Above
                    then TriggerTypeEnum -> Greater,
                level: MapFxTargetLevelToPrice(
                            fpmlLowerBound -> level,
                            fpmlLowerBound -> strikeReference,
                            fpmlLowerBound -> pivotReference,
                            fpmlLowerBound -> barrierReference,
                            fpmlLowerBound -> levelReference,
                            fpmlFxTargetKnockoutForward
                        )
            }

func MapFxTargetRegionUpperBoundToFixingBound:
    inputs:
        fpmlUpperBound fpml.FxTargetRegionUpperBound (0..1)
        fpmlFxTargetKnockoutForward fpml.FxTargetKnockoutForward (0..1)
    output:
        fixingBound FixingBound (0..1)

    set fixingBound:
        if fpmlUpperBound exists
        then FixingBound {
                triggerType: if fpmlUpperBound -> condition = AtOrBelow
                        then TriggerTypeEnum -> EqualOrLess
                    else if fpmlUpperBound -> condition = Below
                    then TriggerTypeEnum -> Less,
                level: MapFxTargetLevelToPrice(
                            fpmlUpperBound -> level,
                            fpmlUpperBound -> strikeReference,
                            fpmlUpperBound -> pivotReference,
                            fpmlUpperBound -> barrierReference,
                            fpmlUpperBound -> levelReference,
                            fpmlFxTargetKnockoutForward
                        )
            }

func MapFxTargetLevelToPrice: <"Maps a level of a TARF (e.g. a region bound or a leverage condition), either as an explicit level, as an address to a strike, or as the value of the referenced pivot, barrier or level.">
    inputs:
        fpmlLevel fpml.FxLevel (0..1)
        fpmlStrikeReference fpml.FxStrikeReference (0..1)
        fpmlPivotReference fpml.FxPivotReference (0..1)
        fpmlBarrierReference fpml.FxComplexBarrierBaseReference (0..1)
        fpmlLevelReference fpml.FxLevelReference (0..1)
        fpmlFxTargetKnockoutForward fpml.FxTargetKnockoutForward (0..1)
    output:
        level PriceSchedule (0..1)
            [metadata address]

    alias fpmlReferencedLevel:
        GetFxTargetLevelList(fpmlFxTargetKnockoutForward)
            filter id = fpmlLevelReference -> href
            then first

    alias fpmlReferencedBarrier:
        fpmlFxTargetKnockoutForward -> barrier
            filter id = fpmlBarrierReference -> href
            then only-element

    set level:
        if fpmlLevel exists
        then MapFxTargetRateToPrice(fpmlLevel -> initialValue, fpmlFxTargetKnockoutForward)
        else if fpmlStrikeReference exists
        then CreatePriceWithAddress(CreatePriceKey(fpmlStrikeReference -> href, empty))
        else if fpmlPivotReference exists
        then MapFxTargetRateToPrice(
                    fpmlFxTargetKnockoutForward -> pivot -> initialValue,
                    fpmlFxTargetKnockoutForward
                )
        else if fpmlBarrierReference exists
        then MapFxTargetRateToPrice(
                    fpmlReferencedBarrier -> triggerRate -> initialValue,
                    fpmlFxTargetKnockoutForward
                )
        else if fpmlLevelReference exists
        then MapFxTargetRateToPrice(
                    fpmlReferencedLevel -> initialValue,
                    fpmlFxTargetKnockoutForward
                )

func GetFxTargetLevelList: <"Returns the explicit levels of a TARF which may be referenced by a level reference.">
    inputs:
        fpmlFxTargetKnockoutForward fpml.FxTargetKnockoutForward (0..1)
    output:
        fpmlLevelList fpml.FxLevel (0..*)

    alias fpmlLinearPayoffRegionList:
        GetFxTargetLinearPayoffRegionList(fpmlFxTargetKnockoutForward)

    alias fpmlConstantPayoffRegionList:
        GetFxTargetConstantPayoffRegionList(fpmlFxTargetKnockoutForward)

    add fpmlLevelList:
        fpmlFxTargetKnockoutForward -> target -> accumulationRegion -> lowerBound -> level

    add fpmlLevelList:
        fpmlFxTargetKnockoutForward -> target -> accumulationRegion -> upperBound -> level

    add fpmlLevelList: fpmlLinearPayoffRegionList -> lowerBound -> level

    add fpmlLevelList: fpmlLinearPayoffRegionList -> upperBound -> level

    add fpmlLevelList: fpmlLinearPayoffRegionList -> leverage -> level

    add fpmlLevelList: fpmlConstantPayoffRegionList -> lowerBound -> level

    add fpmlLevelList: fpmlConstantPayoffRegionList -> upperBound -> level

func MapFxTargetBarrierToTriggerEvent: <"Maps a global knock-out barrier of a TARF.">
    inputs:
        fpmlFxTargetBarrier fpml.FxTargetBarrier (0..1)
        fpmlFxTargetKnockoutForward fpml.FxTargetKnockoutForward (0..1)
    output:
        triggerEvent TriggerEvent (0..1)

    set triggerEvent:
        if fpmlFxTargetBarrier exists
        then TriggerEvent {
                trigger:
                    Trigger {
                        level: MapFxTargetRateToPrice(
                                    fpmlFxTargetBarrier -> triggerRate -> initialValue,
                                    fpmlFxTargetKnockoutForward
                                ),
                        triggerType: MapFxConditionEnum(fpmlFxTargetBarrier -> condition),
                        triggerTimeType: if fpmlFxTargetBarrier -> style = American
                                then TriggerTimeTypeEnum -> Anytime
                            else if fpmlFxTargetBarrier -> style = European
                            then TriggerTimeTypeEnum -> Closing,
                        ...
                    },
                ...
            }

func MapFxTargetRateToPrice: <"Maps an exchange rate level of a TARF (strike, barrier or region bound) to a price, quoted as per the quoted currency pair.">
    inputs:
        rate number (0..1)
        fpmlFxTargetKnockoutForward fpml.FxTargetKnockoutForward (0..1)
    output:
        price PriceSchedule (0..1)

    alias quotedCurrencyPair: fpmlFxTargetKnockoutForward -> quotedCurrencyPair

    alias fpmlCurrency:
        if quotedCurrencyPair -> quoteBasis = Currency1PerCurrency2
        then quotedCurrencyPair -> currency1
        else quotedCurrencyPair -> currency2

    alias fpmlPerCurrency:
        if quotedCurrencyPair -> quoteBasis = Currency1PerCurrency2
        then quotedCurrencyPair -> currency2
        else quotedCurrencyPair -> currency1

    set price:
        if rate exists
        then PriceSchedule {
                value: rate,
                unit:
                    UnitType {
                        currency: MapCurrency(fpmlCurrency),
                        ...
                    },
                perUnitOf:
                    UnitType {
                        currency: MapCurrency(fpmlPerCurrency),
                        ...
                    },
                priceType: PriceTypeEnum -> ExchangeRate,
                ...
            }

func MapFxConditionEnum:
    inputs:
        fpmlCondition fpml.ConditionEnum (0..1)
    output:
        triggerType TriggerTypeEnum (0..1)

    set triggerType:
        if fpmlCondition = AtOrAbove
        then TriggerTypeEnum -> EqualOrGreater
        else if fpmlCondition = Above
        then TriggerTypeEnum -> Greater
        else if fpmlCondition = AtOrBelow
        then TriggerTypeEnum -> EqualOrLess
        else if fpmlCondition = Below
        then TriggerTypeEnum -> Less

func MapFxTargetStyleEnum:
    inputs:
        fpmlTargetStyle fpml.FxTargetStyleEnum (0..1)
    output:
        targetStyle TargetStyleEnum (0..1)

    set targetStyle:
        if fpmlTargetStyle = Exclusive
        then TargetStyleEnum -> Exclusive
        else if fpmlTargetStyle = Exact
        then TargetStyleEnum -> Exact
        else if fpmlTargetStyle = Inclusive
        then TargetStyleEnum -> Inclusive

func MapFxSettlementAdjustmentMethodEnum:
    inputs:
        fpmlSettlementAdjustmentMethod fpml.FxSettlementAdjustmentMethodEnum (0..1)
    output:
        settlementAdjustmentStyle SettlementAdjustmentStyleEnum (0..1)

    set settlementAdjustmentStyle:
        if fpmlSettlementAdjustmentMethod = VariedStrike
        then SettlementAdjustmentStyleEnum -> VariedStrike
        else if fpmlSettlementAdjustmentMethod = VariedNotional
        then SettlementAdjustmentStyleEnum -> VariedNotional

func MapFxTargetKnockoutForwardPriceQuantityList:
    inputs:
        fpmlFxTargetKnockoutForward fpml.FxTargetKnockoutForward (0..1)
    output:
        priceQuantityList PriceQuantity (0..*)

    alias fpmlLinearPayoffRegionList:
        GetFxTargetLinearPayoffRegionList(fpmlFxTargetKnockoutForward)

    alias fpmlNotionalAmount: fpmlFxTargetKnockoutForward -> notionalAmount

    add priceQuantityList:
        if fpmlLinearPayoffRegionList exists
        then PriceQuantity {
                price: MapFxTargetKnockoutForwardPriceList(fpmlFxTargetKnockoutForward),
                quantity: CreateQuantityWithLocation(
                            MapCurrencyAmountToQuantity(
                                    fpmlNotionalAmount -> initialValue,
                                    empty,
                                    fpmlNotionalAmount -> currency,
                                    empty
                                ),
                            CreateQuantityKey(
                                    fpmlNotionalAmount -> currency -> value,
                                    empty
                                )
                        ),
                observable: MapCurrencyToObservableCashWithLocation(
                            fpmlNotionalAmount -> currency,
                            empty
                        ),
                ...
            }

    add priceQuantityList:
        GetFxTargetConstantPayoffRegionList(fpmlFxTargetKnockoutForward)
            filter payoff -> payment exists
            then extract
                PriceQuantity {
                    quantity: CreateQuantityWithLocation(
                                MapCurrencyAmountToQuantity(
                                        item -> payoff -> payment -> amount,
                                        empty,
                                        item -> payoff -> payment -> currency,
                                        empty
                                    ),
                                CreateQuantityKey(
                                        "constantPayoff" + item -> payoff -> payment -> currency -> value,
                                        empty
                                    )
                            ),
                    observable: if item -> payoff -> payment -> currency -> value <> fpmlNotionalAmount -> currency -> value
                            then MapCurrencyToObservableCashWithLocation(
                                    item -> payoff -> payment -> currency,
                                    empty
                                ),
                    ...
                }

func MapFxTargetKnockoutForwardPriceList: <"Maps the strikes of the linear payoff regions and the fixing adjustments of the constant payoff regions of a TARF.">
    inputs:
        fpmlFxTargetKnockoutForward fpml.FxTargetKnockoutForward (0..1)
    output:
        priceList PriceSchedule (0..*)
            [metadata location]

    add priceList:
        GetFxTargetLinearPayoffRegionList(fpmlFxTargetKnockoutForward)
            extract
                CreatePriceWithLocation(
                        MapFxTargetStrikeToPrice(item, fpmlFxTargetKnockoutForward),
                        CreatePriceKey(item -> strike -> id, empty)
                    )

    add priceList:
        GetFxTargetConstantPayoffRegionList(fpmlFxTargetKnockoutForward)
            filter payoff -> fixingAdjustment exists
            then extract
                CreatePriceWithLocation(
                        MapFxTargetFixingAdjustmentToPrice(
                                item -> payoff -> fixingAdjustment,
                                fpmlFxTargetKnockoutForward
                            ),
                        CreatePriceKey("fixingAdjustment", empty)
                    )

func MapFxTargetFixingAdjustmentToPrice: <"Maps the fixing adjustment of a TARF constant payoff region (e.g. the bonus of a bonus collar) to a price expressed as a spread added to the fixing.">
    inputs:
        fixingAdjustment number (0..1)
        fpmlFxTargetKnockoutForward fpml.FxTargetKnockoutForward (0..1)
    output:
        price PriceSchedule (0..1)

    alias rate: MapFxTargetRateToPrice(fixingAdjustment, fpmlFxTargetKnockoutForward)

    set price:
        if rate exists
        then PriceSchedule {
                value: rate -> value,
                unit: rate -> unit,
                perUnitOf: rate -> perUnitOf,
                priceType: rate -> priceType,
                arithmeticOperator: ArithmeticOperationEnum -> Add,
                ...
            }

func MapFxTargetStrikeToPrice: <"Maps the strike of a TARF linear payoff region, including its steps and the counter currency amount.">
    inputs:
        fpmlLinearPayoffRegion fpml.FxTargetLinearPayoffRegion (0..1)
        fpmlFxTargetKnockoutForward fpml.FxTargetKnockoutForward (0..1)
    output:
        price PriceSchedule (0..1)

    alias strike:
        MapFxTargetRateToPrice(
                fpmlLinearPayoffRegion -> strike -> initialValue,
                fpmlFxTargetKnockoutForward
            )

    alias fpmlCounterCurrencyAmount: fpmlLinearPayoffRegion -> counterCurrencyAmount

    set price:
        if strike exists
        then PriceSchedule {
                value: strike -> value,
                datedValue: MapScheduleToDatedValueList(
                            fpmlLinearPayoffRegion -> strike -> step
                        ),
                unit: strike -> unit,
                perUnitOf: strike -> perUnitOf,
                priceType: strike -> priceType,
                derivedQuantity: if fpmlCounterCurrencyAmount exists
                        then CreateQuantityWithLocation(
                                MapCurrencyAmountToQuantity(
                                        fpmlCounterCurrencyAmount -> initialValue,
                                        empty,
                                        fpmlCounterCurrencyAmount -> currency,
                                        empty
                                    ),
                                CreateQuantityKey(
                                        fpmlCounterCurrencyAmount -> currency -> value,
                                        empty
                                    )
                            ),
                ...
            }
